# Server
PORT=4000

# App database (PostgreSQL — lifecycle state Nextcloud doesn't provide)
APP_DB_HOST=app-db
APP_DB_PORT=5432
APP_DB_NAME=guest_lifecycle
APP_DB_USER=lifecycle_admin
APP_DB_PASSWORD=changeme

# Nextcloud integration
# Use the container name "nextcloud" if running via docker-compose,
# or http://localhost:8080 if the backend runs outside Docker.
NEXTCLOUD_BASE_URL=http://nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_APP_PASSWORD=replace-with-generated-app-password

# Policy defaults (used by jobs/inactivityCheck.js and jobs/expiryCheck.js)
INACTIVITY_THRESHOLD_DAYS=30
EXPIRY_WARNING_DAYS=7
